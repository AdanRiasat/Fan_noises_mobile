            android:fillColor="#FFFFFFFF"
            android:pathData="M9.4,7 a2.6,4.2 0 1,0 5.2,0 a2.6,4.2 0 1,0 -5.2,0z" />
    </group>
    <group android:pivotX="12" android:pivotY="12" android:rotation="120">
